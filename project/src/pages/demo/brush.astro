---
import { readFileSync } from 'fs';
import { join } from 'path';
import Layout from '../../layouts/Layout.astro';
import ThemeBrushStorePage from '../../components/ThemeBrushStorePage';

const demoItem = JSON.parse(readFileSync(join(process.cwd(), 'demo_seed', 'output', 'demo-ramen.json'), 'utf-8'));
const demoContent = demoItem.ContentData;

// Demo data (demo-ramen: ラーメン専門店 麺や一徹)
const mockData = {
  theme: 'brush',
  header: demoContent.header,
  hero: demoContent.hero,
  about: demoContent.about,
  menu: demoContent.menu,
  storeInfo: demoContent.storeInfo,
  contact: demoContent.contact,
  footer: demoContent.footer,
  gallery: demoContent.gallery,
  access: demoContent.access,
  news: demoContent.news,
  faq: demoContent.faq,
  staff: demoContent.staff,
  pricing: demoContent.pricing,
  company: demoContent.company,
  cta: demoContent.cta
};
---

<Layout title="Brush Theme Demo">
  <ThemeBrushStorePage client:load initialData={mockData} initialLanguage="ja" showDemoBanner={true} />
</Layout>
