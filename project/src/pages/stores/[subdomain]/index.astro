---
import { fetchStoreContentAtBuildTime, getStoreList } from '../../../services/buildTimeApi';
import { mapDynamoDBDataToPageData } from '../../../services/dataMapper';
import Layout from '../../../layouts/Layout.astro';
import StorePage from '../../../components/StorePage';
import Theme2StorePage from '../../../components/Theme2StorePage';
import Theme3StorePage from '../../../components/Theme3StorePage';
import Theme4StorePage from '../../../components/Theme4StorePage';
import Theme5StorePage from '../../../components/Theme5StorePage';
import ThemeEmberStorePage from '../../../components/ThemeEmberStorePage';
import ThemeWarmStorePage from '../../../components/ThemeWarmStorePage';
import ThemeBlazeStorePage from '../../../components/ThemeBlazeStorePage';
import ThemeCharStorePage from '../../../components/ThemeCharStorePage';
import ThemeKuraStorePage from '../../../components/ThemeKuraStorePage';
import ThemeShiroStorePage from '../../../components/ThemeShiroStorePage';
import ThemeBrushStorePage from '../../../components/ThemeBrushStorePage';
import ThemeMistStorePage from '../../../components/ThemeMistStorePage';
import ThemePopStorePage from '../../../components/ThemePopStorePage';

export async function getStaticPaths() {
  try {
    const storeList = await getStoreList();
    console.log("Found stores:", storeList.length);


  const paths = [];
  for (const { storeId, subdomain, contact_email, templateId } of storeList) {
    console.log(`Processing store: ${storeId}`);
    const storeContent = await fetchStoreContentAtBuildTime(storeId);
    if (!storeContent) {
      console.log(`Skipping ${storeId} because storeContent is null`);
      await new Promise(resolve => setTimeout(resolve, 200));
      continue;
    }
    console.log(`Successfully processed ${storeId}`);

    const pageData = mapDynamoDBDataToPageData(storeContent);

    // DynamoDB Stores テーブルの contact_email を注入
    if (contact_email) {
      pageData.contactEmail = contact_email;
    }

    // DynamoDB Stores テーブルの templateId を settings.theme に注入
    // ContentData 内に templateId があればそちらを優先
    const contentTemplateId = storeContent?.templateId || storeContent?.ContentData?.templateId;
    const themeFromSettings = (pageData.settings as any)?.theme;
    const resolvedTheme = contentTemplateId || templateId || (themeFromSettings && themeFromSettings !== 'theme1' ? themeFromSettings : null) || 'theme1';

    if (!pageData.settings) {
      pageData.settings = { theme: resolvedTheme } as any;
    } else {
      (pageData.settings as any).theme = resolvedTheme;
    }

    paths.push({
      params: { subdomain },
      props: { pageData, storeId, subdomain },
    });

    await new Promise(resolve => setTimeout(resolve, 200));
  }

  const finalPaths = paths.filter(Boolean);
  console.log("Total generated paths:", finalPaths.length);
  return finalPaths;
  } catch (e: any) {
    import('fs').then(fs => fs.writeFileSync('astro-error.log', String(e.stack || e)));
    throw e;
  }
}

const { pageData, storeId, subdomain } = Astro.props;
const currentTheme = typeof pageData.settings?.theme === 'string' ? pageData.settings.theme : 'theme1';


// 動的SEOメタタグ生成（日本語用）
const getLocalText = (field: any, lang: string = 'ja') => {
  if (!field) return '';
  if (typeof field === 'string') return field;
  return field[lang] || field['ja'] || '';
};

const storeName = getLocalText(pageData.header?.logo?.text, 'ja') || 'Store';
const heroCatch = getLocalText(pageData.hero?.title, 'ja');
const metaTitle = heroCatch ? `${storeName} | ${heroCatch}` : storeName;

const heroDesc = getLocalText(pageData.hero?.subtitle, 'ja');
const aboutDesc = getLocalText(pageData.about?.features?.[0]?.description, 'ja');
const metaDescription = `${heroDesc ? heroDesc + '。' : ''}${aboutDesc}`.substring(0, 150);

const currentPath = `/`;
const alternateLinks = [
  { lang: 'ja', href: currentPath },
  { lang: 'en', href: `${currentPath}en/` },
  { lang: 'ko', href: `${currentPath}ko/` },
  { lang: 'zh-tw', href: `${currentPath}zh-tw/` },
];
---

<Layout title={metaTitle} description={metaDescription} lang="ja" alternateLinks={alternateLinks}>
  {currentTheme === 'theme1' && <StorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'theme2' && <Theme2StorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'theme3' && <Theme3StorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'theme4' && <Theme4StorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'theme5' && <Theme5StorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'ember' && <ThemeEmberStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'warm' && <ThemeWarmStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'blaze' && <ThemeBlazeStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'char' && <ThemeCharStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'kura' && <ThemeKuraStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'shiro' && <ThemeShiroStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'brush' && <ThemeBrushStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'mist' && <ThemeMistStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
  {currentTheme === 'pop' && <ThemePopStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath={currentPath} />}
</Layout>
