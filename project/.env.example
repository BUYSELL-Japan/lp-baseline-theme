# Supabase (not used in current SSG setup, but available if needed)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=your_supabase_url

# Build-time SSG configuration

# Set to 'false' in production to fetch from real API
USE_FALLBACK_DATA=true

# Set to 'false' in production to dynamically fetch store list
USE_STATIC_STORE_LIST=true

# Comma-separated list of store IDs to pre-render (only used when USE_STATIC_STORE_LIST=true)
STORE_LIST=OKI1011,STORE002,STORE003

# API endpoint to fetch list of all stores (only used when USE_STATIC_STORE_LIST=false)
STORE_LIST_API_ENDPOINT=https://your-api.com/stores/list
