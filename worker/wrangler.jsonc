{
  "name": "subdomain-router",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-12-16",
  "routes": [
    {
      "pattern": "global-reaches.com/*",
      "zone_name": "global-reaches.com"
    },
    {
      "pattern": "*.global-reaches.com/*",
      "zone_name": "global-reaches.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}