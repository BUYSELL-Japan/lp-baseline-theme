---
import { readFileSync } from 'fs';
import { join } from 'path';
import Layout from '../../layouts/Layout.astro';
import ThemeMistStorePage from '../../components/ThemeMistStorePage';
import type { PageData } from '../../services/dataMapper';

const demoItem = JSON.parse(readFileSync(join(process.cwd(), 'demo_seed', 'output', 'demo-soba.json'), 'utf-8'));
const demoContent = demoItem.ContentData;

const pageData: PageData = {
  header: demoContent.header,
  hero: demoContent.hero,
  about: demoContent.about,
  menu: demoContent.menu,
  storeInfo: demoContent.storeInfo,
  contact: demoContent.contact,
  footer: demoContent.footer,
  gallery: demoContent.gallery,
  staff: demoContent.staff,
  news: demoContent.news,
  access: demoContent.access,
  faq: demoContent.faq,
  cta: demoContent.cta,
  pricing: demoContent.pricing,
  company: demoContent.company,
  settings: demoContent.settings,
};
---

<Layout title="Demo: Mist Theme | Landy" description="Landy Mist theme demo">
  <ThemeMistStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath="/demo/mist" />
</Layout>
