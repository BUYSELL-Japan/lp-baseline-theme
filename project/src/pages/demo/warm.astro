---
import { readFileSync } from 'fs';
import { join } from 'path';
import Layout from '../../layouts/Layout.astro';
import ThemeWarmStorePage from '../../components/ThemeWarmStorePage';
import type { PageData } from '../../services/dataMapper';

const demoItem = JSON.parse(readFileSync(join(process.cwd(), 'demo_seed', 'output', 'demo-izakaya.json'), 'utf-8'));
const demoContent = demoItem.ContentData;

const pageData: PageData = {
  header: demoContent.header,
  hero: demoContent.hero,
  about: demoContent.about,
  menu: demoContent.menu,
  storeInfo: demoContent.storeInfo,
  contact: demoContent.contact,
  footer: demoContent.footer,
  gallery: demoContent.gallery,
  staff: demoContent.staff,
  reviews: demoContent.reviews,
  news: demoContent.news,
  access: demoContent.access,
  faq: demoContent.faq,
  cta: demoContent.cta,
  pricing: demoContent.pricing,
  company: demoContent.company,
  settings: demoContent.settings,
};
---

<Layout title="Demo: Modern Theme | Landy" description="Landy Modern theme demo">
  <ThemeWarmStorePage client:only="react" pageData={pageData} initialLanguage="ja" basePath="/demo/warm" />
</Layout>
