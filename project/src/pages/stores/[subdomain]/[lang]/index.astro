---
import { fetchStoreContentAtBuildTime, getStoreList } from '../../../../services/buildTimeApi';
import { mapDynamoDBDataToPageData } from '../../../../services/dataMapper';
import Layout from '../../../../layouts/Layout.astro';
import StorePage from '../../../../components/StorePage';
import Theme2StorePage from '../../../../components/Theme2StorePage';
import Theme3StorePage from '../../../../components/Theme3StorePage';
import Theme4StorePage from '../../../../components/Theme4StorePage';
import type { Language } from '../../../../contexts/LanguageContext';

export async function getStaticPaths() {
  const storeList = await getStoreList();
  const languages = ['en', 'ko', 'zh-tw'];

  const paths = await Promise.all(
    storeList.map(async ({ storeId, subdomain, contact_email, templateId }) => {
      const storeContent = await fetchStoreContentAtBuildTime(storeId);
      if (!storeContent) return [];

      const pageData = mapDynamoDBDataToPageData(storeContent);
      // Storesテーブルの contact_email を pageData に注入する
      if (contact_email) {
        pageData.contactEmail = contact_email;
      }

      // DynamoDB Stores テーブルの templateId を settings.theme に注入
      // ContentData 内に templateId があればそちらを優先
      const contentTemplateId = storeContent?.templateId || storeContent?.ContentData?.templateId;
      const themeFromSettings = (pageData.settings as any)?.theme;
      const resolvedTheme = contentTemplateId || (themeFromSettings && themeFromSettings !== 'theme1' ? themeFromSettings : null) || templateId || 'theme1';

      if (!pageData.settings) {
        pageData.settings = { theme: resolvedTheme } as any;
      } else {
        (pageData.settings as any).theme = resolvedTheme;
      }

      return languages.map(lang => ({
        params: { subdomain, lang },
        props: { pageData, storeId, subdomain, lang },
      }));
    })
  );

  return paths.flat().filter(Boolean);
}

const { pageData, storeId, subdomain, lang } = Astro.props;
const currentTheme = pageData.settings?.theme || 'theme1';

// 動的SEOメタタグ生成（各言語用）
const getLocalText = (field: any, targetLang: string) => {
  if (!field) return '';
  if (typeof field === 'string') return field;
  return field[targetLang] || field['en'] || field['ja'] || '';
};

const storeName = getLocalText(pageData.header?.logo?.text, lang) || 'Store';
const heroCatch = getLocalText(pageData.hero?.sectionTitle, lang);
const metaTitle = heroCatch ? `${storeName} | ${heroCatch}` : storeName;

const heroDesc = getLocalText(pageData.hero?.sectionSubtitle, lang);
const aboutDesc = getLocalText(pageData.about?.features?.[0]?.description, lang);
const metaDescription = `${heroDesc ? heroDesc + ' ' : ''}${aboutDesc}`.substring(0, 150);

const currentPath = `/`;
const alternateLinks = [
  { lang: 'ja', href: currentPath },
  { lang: 'en', href: `${currentPath}en/` },
  { lang: 'ko', href: `${currentPath}ko/` },
  { lang: 'zh-tw', href: `${currentPath}zh-tw/` },
];
---

<Layout title={metaTitle} description={metaDescription} lang={lang} alternateLinks={alternateLinks}>
  {currentTheme === 'theme1' && <StorePage client:only="react" pageData={pageData} initialLanguage={lang as Language} basePath={currentPath} />}
  {currentTheme === 'theme2' && <Theme2StorePage client:only="react" pageData={pageData} initialLanguage={lang as Language} basePath={currentPath} />}
  {currentTheme === 'theme3' && <Theme3StorePage client:only="react" pageData={pageData} initialLanguage={lang as Language} basePath={currentPath} />}
  {currentTheme === 'theme4' && <Theme4StorePage client:only="react" pageData={pageData} initialLanguage={lang as Language} basePath={currentPath} />}
</Layout>
